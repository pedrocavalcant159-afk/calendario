rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reminderRequests/{token} {
      allow get: if true;
      allow list, create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        resource.data.active == true &&
        resource.data.processed == false &&
        resource.data.responseVersion == 0 &&
        request.time < resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'responseStatus',
          'responseNote',
          'respondedAt',
          'responseVersion'
        ]) &&
        request.resource.data.responseStatus is string &&
        resource.data.statusKeys.hasAny([request.resource.data.responseStatus]) &&
        request.resource.data.responseNote is string &&
        request.resource.data.responseNote.size() <= 500 &&
        request.resource.data.respondedAt == request.time &&
        request.resource.data.responseVersion == 1
      );
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
