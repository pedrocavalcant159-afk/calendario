[debug] [2026-08-28T18:47:42.165Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/calendario-upli/rulesets {"name":"projects/calendario-upli/rulesets/b57e120d-f7c4-4330-8f23-12c5ddd7118e","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /reminderRequests/{token} {\n      allow get: if true;\n      allow list, create, delete: if request.auth != null;\n      allow update: if request.auth != null || (\n        resource.data.active == true &&\n        resource.data.processed == false &&\n        resource.data.responseVersion == 0 &&\n        request.time < resource.data.expiresAt &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'responseStatus',\n          'responseNote',\n          'respondedAt',\n          'responseVersion'\n        ]) &&\n        request.resource.data.responseStatus is string &&\n        resource.data.statusKeys.hasAny([request.resource.data.responseStatus]) &&\n        request.resource.data.responseNote is string &&\n        request.resource.data.responseNote.size() <= 500 &&\n        request.resource.data.respondedAt == request.time &&\n        request.resource.data.responseVersion == 1\n      );\n    }\n\n    match /{document=**} {\n      allow read, write: if request.auth != null;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-28T18:47:42.289519Z","metadata":{"services":["cloud.firestore"]}}
